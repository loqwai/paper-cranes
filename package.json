{
  "name": "paper-cranes-audio",
  "version": "1.0.2",
  "description": "",
  "type": "module",
  "main": "dist/src/audio/AudioProcessor.js",
  "scripts": {
    "start": "npm run dev",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.js",
    "test:smoke": "vite build && vitest run --config vitest.e2e.config.js e2e/smoke.test.js e2e/relay.test.js",
    "test:smoke:prod": "E2E_BASE_URL=${E2E_BASE_URL:-https://visuals.beadfamous.com} E2E_RELAY=1 vitest run --config vitest.e2e.config.js e2e/smoke.test.js e2e/relay.test.js",
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "format": "eslint --fix .",
    "shader-dates": "node scripts/shader-dates.js",
    "audio": "node scripts/show/audio-swap.js",
    "delete": "node scripts/delete-shader.js",
    "delete:interactive": "node scripts/delete-shader.js --interactive",
    "pilot": "node scripts/show/pilot.js",
    "test:pilot": "node --test scripts/show/pilot-brain.node-test.js",
    "test:setlists": "node --test setlists/*/*.node-test.mjs",
    "test:shader-check": "node --test .agents/skills/shader/bin/shader-check.node-test.mjs"
  },
  "author": "hypnodroid",
  "license": "UNLICENSED",
  "dependencies": {
    "@preact/signals": "^1.3.1",
    "debounce": "^2.2.0",
    "htm": "^3.1.1",
    "hypnosound": "^2.1.0",
    "preact": "^10.25.4",
    "twgl-base.js": "^5.5.3",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/serviceworker": "^0.0.122",
    "@types/vscode": "^1.96.0",
    "chokidar": "^4.0.3",
    "eslint": "^8.57.1",
    "glslang-validator-prebuilt": "^0.0.7",
    "playwright": "^1.55.1",
    "prettier": "^3.4.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.2",
    "zod": "^3.25.76"
  },
  "languages": [
    {
      "id": "paper-cranes-fragment-shader",
      "aliases": [
        "GLSL",
        "glsl"
      ],
      "extensions": [
        ".frag",
        ".glsl"
      ]
    }
  ]
}
